{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .ak-contact-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* Left Side: Contact Info */
  .ak-contact-info {
    flex: 1;
  }

  .ak-contact-info h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: {{ section.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .ak-contact-info p.ak-contact-desc {
    font-size: 1.1rem;
    color: #555555;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 90%;
  }

  .ak-contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ak-contact-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .ak-contact-icon {
    width: 24px;
    height: 24px;
    fill: {{ section.settings.icon_color }};
    flex-shrink: 0;
    margin-top: 4px;
  }

  .ak-contact-text h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
    color: #121212;
  }

  .ak-contact-text p, .ak-contact-text a {
    margin: 0;
    font-size: 1rem;
    color: #555555;
    text-decoration: none;
    line-height: 1.5;
  }

  .ak-contact-text a:hover {
    color: {{ section.settings.icon_color }};
  }

  /* Right Side: The Form */
  .ak-contact-form-wrapper {
    flex: 1;
    background: {{ section.settings.form_bg_color }};
    padding: 3rem;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  }

  .ak-contact-form .field {
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .ak-contact-form-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ak-contact-form input,
  .ak-contact-form textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
    background-color: #ffffff;
    color: #121212;
    transition: border-color 0.3s ease;
  }

  .ak-contact-form input:focus,
  .ak-contact-form textarea:focus {
    outline: none;
    border-color: {{ section.settings.button_bg_color }};
  }

  .ak-contact-form textarea {
    min-height: 150px;
    resize: vertical;
  }

  .ak-contact-form .btn {
    display: inline-block;
    width: 100%;
    padding: 1.2rem;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .ak-contact-form .btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .form-status-success {
    background-color: #d4edda;
    color: #155724;
    padding: 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .form-status-error {
    background-color: #f8d7da;
    color: #721c24;
    padding: 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  /* Desktop Layout */
  @media screen and (min-width: 750px) {
    .ak-contact-container {
      flex-direction: row;
      align-items: center;
    }
    .ak-contact-form-row {
      flex-direction: row;
    }
    .ak-contact-form .field {
      margin-bottom: 0;
    }
    .ak-contact-form-row .field {
      flex: 1;
    }
    .ak-contact-form .field-full {
      margin-bottom: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} ak-contact-section">
  <div class="ak-contact-container">
    
    <!-- Left Side: Information -->
    <div class="ak-contact-info">
      <h2>{{ section.settings.heading }}</h2>
      <p class="ak-contact-desc">{{ section.settings.description }}</p>

      <div class="ak-contact-details">
        {%- for block in section.blocks -%}
          <div class="ak-contact-detail-item" {{ block.shopify_attributes }}>
            
            <!-- SVG Icons based on block type -->
            <svg class="ak-contact-icon" viewBox="0 0 24 24">
              {%- if block.type == 'address' -%}
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              {%- elsif block.type == 'phone' -%}
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
              {%- elsif block.type == 'email' -%}
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              {%- endif -%}
            </svg>

            <div class="ak-contact-text">
              <h4>{{ block.settings.title }}</h4>
              {%- if block.type == 'email' -%}
                <a href="mailto:{{ block.settings.text }}">{{ block.settings.text }}</a>
              {%- elsif block.type == 'phone' -%}
                <a href="tel:{{ block.settings.text | remove: ' ' | remove: '-' }}">{{ block.settings.text }}</a>
              {%- else -%}
                <p>{{ block.settings.text | newline_to_br }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Right Side: Contact Form -->
    <div class="ak-contact-form-wrapper">
      {%- form 'contact', id: 'ak-contact-form', class: 'ak-contact-form' -%}
        
        {%- if form.posted_successfully? -%}
          <div class="form-status-success" tabindex="-1" autofocus>
            Thank you! Your message has been sent successfully. We will get back to you soon.
          </div>
        {%- elsif form.errors -%}
          <div class="form-status-error">
            Oops! There was a problem submitting your message. Please check the fields below.
          </div>
        {%- endif -%}

        <div class="ak-contact-form-row field-full">
          <div class="field">
            <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your Name" required>
          </div>
          <div class="field">
            <input autocomplete="email" type="email" id="ContactForm-email" class="field__input" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" placeholder="Email Address" required>
          </div>
        </div>

        <div class="field field-full">
          <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone Number (Optional)">
        </div>

        <div class="field field-full">
          <textarea id="ContactForm-body" class="text-area field__input" name="contact[body]" placeholder="How can we help you?" required>{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
        </div>

        <button type="submit" class="btn">
          {{ section.settings.button_text }}
        </button>

      {%- endform -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "AK Contact Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "header",
      "content": "Left Column: Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have a project in mind or need a quote for custom packaging? Fill out the form and our team will get back to you within 24 hours."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Right Column: Form UI"
    },
    {
      "type": "color",
      "id": "form_bg_color",
      "label": "Form Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send Message"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "address",
      "name": "Address",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Office Address"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Address Details",
          "default": "123 Packaging Lane\nRamapuram, Chennai 600089"
        }
      ]
    },
    {
      "type": "phone",
      "name": "Phone Number",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Us"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Phone Number",
          "default": "+91 98765 43210"
        }
      ]
    },
    {
      "type": "email",
      "name": "Email Address",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Email Us"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Email",
          "default": "hello@akprinters.net"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK Contact Section",
      "blocks": [
        { "type": "address" },
        { "type": "phone" },
        { "type": "email" }
      ]
    }
  ]
}
{% endschema %}