{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .ak-contact-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Centered Header Section */
  .ak-contact-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .ak-contact-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: {{ section.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .ak-contact-header p.ak-contact-desc {
    font-size: 1.1rem;
    color: #555555;
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  /* Three Column Grid Setup */
  .ak-contact-grid {
    display: grid;
    grid-template-columns: 1fr; /* 1 column on mobile */
    gap: 2rem;
  }

  .ak-contact-item {
    background-color: #ffffff;
    padding: 3rem 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s ease;
  }

  .ak-contact-item:hover {
    transform: translateY(-5px);
  }

  .ak-contact-icon {
    width: 40px;
    height: 40px;
    fill: {{ section.settings.icon_color }};
    margin-bottom: 1.5rem;
  }

  .ak-contact-item h4 {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
    color: #121212;
    font-weight: 600;
  }

  .ak-contact-item p, 
  .ak-contact-item a {
    margin: 0;
    font-size: 1.05rem;
    color: #555555;
    text-decoration: none;
    line-height: 1.6;
  }

  .ak-contact-item a:hover {
    color: {{ section.settings.icon_color }};
  }

  /* Desktop Layout: 3 Columns */
  @media screen and (min-width: 750px) {
    .ak-contact-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} ak-contact-section">
  <div class="ak-contact-container">
    
    <!-- Top Heading & Description -->
    <div class="ak-contact-header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="ak-contact-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- 3-Column Info Row -->
    <div class="ak-contact-grid">
      {%- for block in section.blocks -%}
        <div class="ak-contact-item" {{ block.shopify_attributes }}>
          
          <!-- SVG Icons -->
          <svg class="ak-contact-icon" viewBox="0 0 24 24">
            {%- if block.type == 'address' -%}
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-1.12 2.5-2.5-1.12 2.5-2.5 2.5z"/>
            {%- elsif block.type == 'phone' -%}
              <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
            {%- elsif block.type == 'email' -%}
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            {%- endif -%}
          </svg>

          <!-- Text Details -->
          <h4>{{ block.settings.title }}</h4>
          {%- if block.type == 'email' -%}
            <a href="mailto:{{ block.settings.text }}">{{ block.settings.text }}</a>
          {%- elsif block.type == 'phone' -%}
            <a href="tel:{{ block.settings.text | remove: ' ' | remove: '-' }}">{{ block.settings.text }}</a>
          {%- else -%}
            <p>{{ block.settings.text | newline_to_br }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "AK Contact Row",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We would love to hear from you. Reach out to us using any of the methods below."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Card Icon & Hover Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "address",
      "name": "Address Card",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Office Address"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Address Details",
          "default": "123 Packaging Lane\nRamapuram, Chennai"
        }
      ]
    },
    {
      "type": "phone",
      "name": "Phone Card",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Us"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Phone Number",
          "default": "+91 98765 43210"
        }
      ]
    },
    {
      "type": "email",
      "name": "Email Card",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Email Us"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Email",
          "default": "hello@akprinters.net"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK Contact Row",
      "blocks": [
        { "type": "address" },
        { "type": "phone" },
        { "type": "email" }
      ]
    }
  ]
}
{% endschema %}