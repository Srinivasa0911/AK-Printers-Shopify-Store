<div class="ak-logo-slider color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="title-wrapper center">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div
      class="ak-logo-marquee"
      style="
        --logo-width: {{ section.settings.logo_width }}px;
        --scroll-speed: {{ section.settings.scroll_speed }}s;
      "
    >
      <div class="ak-logo-track">

        {% for block in section.blocks %}
          <div class="ak-logo-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  alt: block.settings.alt_text,
                  loading: 'lazy'
              }}
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}

        {% for block in section.blocks %}
          <div class="ak-logo-item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  alt: block.settings.alt_text,
                  loading: 'lazy'
              }}
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "AK Logo Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Leading Brands"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_grayscale",
      "label": "Enable Grayscale",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK Logo Slider"
    }
  ]
}
{% endschema %}