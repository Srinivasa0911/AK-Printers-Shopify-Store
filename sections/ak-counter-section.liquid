<section class="counter-section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="counter-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="counter-grid">

      {% for block in section.blocks %}
        <div class="counter-box">

          {% if block.settings.icon != blank %}
            <div class="counter-icon">
              <img src="{{ block.settings.icon | img_url: '100x' }}" alt="">
            </div>
          {% endif %}

          <div class="counter-number">
            <span class="count" data-target="{{ block.settings.number }}">0</span>{{ block.settings.suffix }}
          </div>

          {% if block.settings.title != blank %}
            <div class="counter-title">{{ block.settings.title }}</div>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const counters = document.querySelectorAll('.count');

  counters.forEach(counter => {
    const updateCount = () => {
      const target = +counter.getAttribute('data-target');
      const current = +counter.innerText;
      const increment = Math.ceil(target / 80);

      if (current < target) {
        counter.innerText = current + increment;
        setTimeout(updateCount, 30);
      } else {
        counter.innerText = target;
      }
    };

    updateCount();
  });
});
</script>

{% schema %}
{
  "name": "Counter Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Achievements"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We are growing fast with happy clients"
    }
  ],
  "blocks": [
    {
      "type": "counter",
      "name": "Counter Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "number",
          "id": "number",
          "label": "Number",
          "default": 100
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (e.g. +, %, k)",
          "default": "+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Projects Completed"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Counter Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}