<div class="ak-logo-slider color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="title-wrapper center">
        <h2 class="title inline-richtext">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div
      class="ak-logo-marquee{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}{% if section.settings.enable_grayscale %} enable-grayscale{% endif %}"
      style="
        --logo-width: {{ section.settings.logo_width }}px;
        --scroll-speed: {{ section.settings.scroll_speed }}s;
      "
    >
      <div class="ak-logo-track">

        {% for block in section.blocks %}
          <div class="ak-logo-item" {{ block.shopify_attributes }}>

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  alt: block.settings.alt_text,
                  loading: 'lazy'
              }}
            {% else %}
              <div class="ak-logo-placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>
        {% endfor %}

        {% for block in section.blocks %}
          <div class="ak-logo-item">

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  alt: block.settings.alt_text,
                  loading: 'lazy'
              }}
            {% else %}
              <div class="ak-logo-placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</div>

<div class="ak-logo-navigation">
  <button type="button" class="ak-logo-arrow ak-logo-arrow--prev" aria-label="Previous">
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>

  <div class="ak-logo-dots">
    {% for block in section.blocks limit: 6 %}
      <span class="ak-logo-dot"></span>
    {% endfor %}
  </div>

  <button type="button" class="ak-logo-arrow ak-logo-arrow--next" aria-label="Next">
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>
</div>

{% schema %}
{
  "name": "AK Logo Slider",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Leading Brands"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
  "type": "header",
  "content": "Navigation"
},
{
  "type": "checkbox",
  "id": "show_arrows",
  "label": "Show Arrows",
  "default": true
},
{
  "type": "checkbox",
  "id": "show_dots",
  "label": "Show Dot Navigation",
  "default": true
},
    {
      "type": "checkbox",
      "id": "enable_grayscale",
      "label": "Enable Grayscale",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK Logo Slider",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}